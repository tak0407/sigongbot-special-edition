ENV=prod
SESSION_NAME_OVERRIDE=
TEST_SUBMISSION_CHANNEL=
ANNOUNCEMENT_CHANNEL=C_REPLACE_ME
SUBMISSION_TEAMS={}
SUBMISSION_CHANNEL_CHOOSER_IDS=
# 실제 채널 ID와 모임 링크는 운영 .env에만 입력합니다.
ONLINE_RETRO_MEETINGS=[]
DATABASE_PATH=data/sigongbot.db
ANTIGRAVITY_COMMAND=agy
ANTIGRAVITY_MODEL=gemini-3.7-flash-low
AI_REVIEW_TIMEOUT_SECONDS=180
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_APP_TOKEN=xapp-replace-me
ADMIN_CHANNEL=C_REPLACE_ME
SUPPORT_CHANNEL=C_REPLACE_ME
ADMIN_IDS=U_REPLACE_ME
# openssl rand -hex 32 등으로 생성하고 미니 PC의 .env에만 둡니다.
DASHBOARD_SESSION_SECRET=replace-with-at-least-32-random-characters
DASHBOARD_SESSION_HOURS=12
# Cloudflare Zero Trust에서 발급한 Tunnel 토큰. 실제 값은 커밋하지 않습니다.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
# 운영 오류 알림을 받을 Slack Incoming Webhook URL.
# 봇이 설치된 워크스페이스가 아닌 개인 워크스페이스의 알림 채널이어도 되며,
# 비워 두면 알림을 보내지 않고 로그만 남깁니다.
ALERT_WEBHOOK_URL=
